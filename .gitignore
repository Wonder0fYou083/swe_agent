# Secrets: API keys live in .env, which never enters git.
# Commit a .env.example with empty values instead.
.env
.env.*
!.env.example

# Python bytecode and build output
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environment created by `uv sync`
.venv/

# Tool caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Agent trajectories from `swe-agent run`: local data, not source
runs/

# Personal Claude Code settings (shared settings in .claude/ stay tracked)
.claude/settings.local.json

# macOS
.DS_Store

# Private notes and personal Claude Code instructions: never committed
notes/
CLAUDE.local.md
docs/devlog/TEMPLATE.md
